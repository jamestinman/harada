# Supabase Configuration
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Service role (private): required for /api/agent/* (email→user lookup, agent approvals, data on behalf of users). Never expose to the client.
SUPABASE_SECRET_KEY=

# Production web origin for Supabase email links, OAuth, and password recovery (required for App Store / Play builds; never use capacitor://localhost)
PUBLIC_APP_ORIGIN=https://www.haradato.com

# GOOGLE
GOOGLE_API_KEY=
# Google Cloud Text-to-Speech (service account JSON, one line — same as Echowalk /api/say)
GCP_SERVICE_ACCOUNT_JSON=