{
	"name": "haradato",
	"private": true,
	"version": "1.0.27",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5026 --open",
		"build": "vite build",
		"electron:sync": "BUILD_TARGET=static npm run build && npx cap sync electron",
		"electron": "npm run electron:sync && cd electron && npm run electron:start-live",
		"electron:make": "npm run electron:sync && cd electron && npm run electron:make",
		"ios": "./prepare.sh dev && BUILD_TARGET=static vite build && npx cap run ios --target=\"370C98FE-A014-483B-8DA2-96F896BBE035\"",
		"android": "./prepare.sh dev && BUILD_TARGET=static vite build && npx cap run android",
		"preview": "vite preview",
		"test:todo-utils": "node --test src/lib/todoUtils.test.mjs",
		"test:url-utils": "node --test src/lib/urlUtils.test.mjs",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"electron": "^41.0.0",
		"svelte": "^5.45.6",
		"tailwindcss": "^4.1.17",
		"vite": "^7.2.6"
	},
	"dependencies": {
		"@capacitor-community/electron": "^5.0.1",
		"@capacitor/android": "^8.0.2",
		"@capacitor/app": "^8.1.0",
		"@capacitor/cli": "^8.0.2",
		"@capacitor/core": "^8.0.2",
		"@capacitor/ios": "^8.0.2",
		"@capacitor/keyboard": "^8.0.1",
		"@capacitor/preferences": "^8.0.0",
		"@capacitor/share": "^8.0.0",
		"@chenglou/pretext": "^0.0.3",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@google-cloud/text-to-speech": "^6.4.1",
		"@lezer/highlight": "^1.2.3",
		"@mozilla/readability": "^0.6.0",
		"@supabase/supabase-js": "^2.95.3",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.3.0",
		"dompurify": "^3.4.13",
		"dotenv": "^16.6.1",
		"jsdom": "^29.1.1",
		"katex": "^0.17.0",
		"lucide-svelte": "^0.563.0",
		"marked": "^17.0.3",
		"marked-katex-extension": "^5.1.10",
		"undici": "^8.5.0",
		"unpdf": "^1.6.2"
	}
